# --- Database ---------------------------------------------------------------
# Local/dev: SQLite file. Production: switch prisma/schema.prisma provider to
# "postgresql" and use a Postgres URL (Neon / Supabase free tier).
DATABASE_URL="file:./dev.db"

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:9002"
NEXT_PUBLIC_APP_URL="http://localhost:9002"
# Optional Google login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated emails that become admins (can review reports) on sign-up
ADMIN_EMAILS=""

# --- AI: any OpenAI-compatible API. Without it the engine runs on rules + reputation + feeds.
# AI_PROVIDER: openai | openrouter | groq | together | deepseek | gemini | azure | ollama | lmstudio | vllm | custom
AI_PROVIDER=""
# Leave empty to use the provider's default URL (required for azure and custom).
AI_BASE_URL=""
AI_API_KEY=""
# Leave empty for the provider's suggested model. Use "Test connection" in Developer settings to check.
AI_MODEL=""
# Optional separate model for screenshots; AI_VISION=0 turns image reading off.
AI_VISION_MODEL=""
AI_VISION=""
# json_schema | json_object | prompt (default comes from the provider preset; downgrades automatically)
AI_JSON_MODE=""
# A number, "none" to never send temperature, or empty for per-request defaults
AI_TEMPERATURE=""
AI_TIMEOUT_MS="20000"
# Daily platform-paid AI calls per organisation / for anonymous checks (0 = unlimited)
AI_PLATFORM_DAILY_CALLS_PER_ORG="500"
AI_PLATFORM_DAILY_CALLS_PUBLIC="2000"
# Let organisations' own (BYOK) endpoints use private/local addresses. Keep 0 on shared servers.
AI_ALLOW_PRIVATE_ENDPOINTS="0"

# --- Detection engine
# community (default, bundled) or module (a separately distributed engine, see docs/open-core.md)
AABO_ENGINE="community"
AABO_ENGINE_MODULE=""
# Set to 1 in production so a missing engine module fails loudly instead of falling back.
AABO_ENGINE_REQUIRED="0"
# Extra official domains (comma-separated) the community engine treats as legitimate
AABO_TRUSTED_DOMAINS=""

# --- Threat intel (all optional; each layer is skipped when its key is missing)
GOOGLE_SAFE_BROWSING_API_KEY=""
URLHAUS_AUTH_KEY=""
PHISHTANK_APP_KEY=""
# Set to "0" to disable network lookups (RDAP domain age, link unshortening)
INTEL_NETWORK_LOOKUPS="1"

# --- Messaging gateway ------------------------------------------------------
# WhatsApp transport: "baileys" (linked device). "cloud" (official API) is reserved for later.
WHATSAPP_TRANSPORT="baileys"
# Phone number (digits, intl format, e.g. 2348012345678) of the dedicated Ààbò bot number.
# When set, the gateway links it with a pairing code; otherwise it prints a QR in the terminal.
WA_BOT_PHONE=""
# Set to "0" to run the gateway without the shared bot (Guardian sessions only)
WA_BOT_ENABLED="1"
# Free-tier daily check limit per chat user
FREE_DAILY_CHECKS="20"
TELEGRAM_BOT_TOKEN=""
# Public Telegram bot username (without @) shown in the PWA
NEXT_PUBLIC_TELEGRAM_BOT=""
# Public WhatsApp number of the bot shown in the PWA (wa.me link), digits only
NEXT_PUBLIC_WA_BOT_NUMBER=""

# --- Web push (generate with: npx web-push generate-vapid-keys) --------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:security@example.com"
